---
/* src/components/sections/Hero.astro */
import { getHero, getStrapiMediaUrl } from "@/lib/strapi";
import defaultHeroImg from "@/assets/images/Hero-w-bg.jpg";

const hero = await getHero("home");
const strapiHeroImageUrl = getStrapiMediaUrl(hero?.image?.url);
const heroImageSrc = strapiHeroImageUrl;
---

<section
  id="home"
  class="relative z-0 w-full min-h-screen md:w-screen md:min-w-screen md:h-screen md:shrink-0 bg-white border-b-2 md:border-b-0 md:border-r-2 border-black flex flex-col md:flex-row items-center justify-center overflow-hidden pl-0 md:pl-15"
>
  <span data-pagefind-meta="title" style="display: none;">Hero</span>

  <div class="w-full h-full relative flex items-center justify-center">
    {heroImageSrc ? (
      <img
        src={heroImageSrc}
        alt={hero?.image?.alternativeText || "Portfolio Hero"}
        class="w-full h-full object-cover"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-xs font-mono text-neutral-400">
        NO HERO IMAGE
      </div>
    )}
  </div>
</section>
