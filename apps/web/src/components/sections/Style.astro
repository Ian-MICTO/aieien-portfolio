---
import { getStylePanels, getStrapiMediaUrl } from "@/lib/strapi";
import StylePanel from "@/components/StylePanel";

interface PanelStyleConfig {
  className: string;
  clipPath: string;
}

// Styling configurations keyed by panel identifier ("01", "02", "03", "04")
const STYLE_PANEL_CONFIGS: Record<string, PanelStyleConfig> = {
  "01": {
    className: "w-[30%] h-[103%] -mt-6 z-10",
    clipPath: "polygon(0 0, 100% 0, 82% 100%, 0 100%)",
  },
  "02": {
    className: "w-[22%] h-[98%] mt-15 -ml-3 z-20",
    clipPath: "polygon(18% 0, 100% 0, 80% 100%, 0% 100%)",
  },
  "03": {
    className: "w-[32%] h-[106%] -mt-20 -ml-4 z-30",
    clipPath: "polygon(20% 0, 100% 0, 74% 100%, 0% 100%)",
  },
  "04": {
    className: "w-[24%] h-[97%] mt-16 -ml-4 z-40",
    clipPath: "polygon(26% 0, 100% 0, 100% 100%, 0 100%)",
  },
};

const getPanelClasses = (panelNumber: string) => {
  return STYLE_PANEL_CONFIGS[panelNumber] || STYLE_PANEL_CONFIGS["01"];
}

const panels = await getStylePanels();

const pageName = "Styles";
---

<section
  id="style"
  class="relative z-0 w-full min-h-screen md:w-screen md:min-w-screen md:h-screen md:shrink-0 bg-white border-b-2 md:border-b-0 md:border-r-2 border-black flex flex-col pl-0 md:pl-15"
>
  <!-- Halftone Effect Background Across Whole Page -->
  <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#000_1px,transparent_1px)] bg-size-[8px_8px] pointer-events-none z-0"></div>

  <span data-pagefind-meta="title" style="display: none;">{pageName}</span>

  <!-- Section Header Bar -->
  <div class="relative z-10 px-4 sm:px-6 pt-16 md:pt-4 pb-3 sm:pb-4 flex items-center justify-between shrink-0 bg-transparent">
    <div class="flex items-center gap-3">
      <span class="text-xs font-mono font-bold tracking-widest uppercase bg-black text-white px-2 py-0.5">
        Ch. 03
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight uppercase">
        Styles
      </h2>
    </div>
    <span class="z-10 text-xs font-mono text-neutral-500 uppercase tracking-wide hidden sm:inline">
      Art Styles / Production
    </span>
  </div>

  <!-- Content Area -->
  <div class="relative z-10 flex-1 w-full min-h-0 overflow-visible md:overflow-hidden p-3 sm:p-4 md:p-6 flex flex-col">

    <!-- Mobile Layout: Full-Width Stacked Landscape Panels (Reference Style) -->
    <div class="flex md:hidden flex-col gap-6 w-full relative z-10 pb-8">
      {panels.map((panel) => {
        const fullImageUrl = getStrapiMediaUrl(panel.image?.url);
        return (
          <div class="w-full flex flex-col">
            <div class="relative w-full aspect-16/10 sm:aspect-video border border-black overflow-hidden bg-white">
              {fullImageUrl ? (
                <img
                  src={fullImageUrl}
                  alt={panel.image?.alternativeText || panel.title}
                  class="absolute inset-0 w-full h-full object-cover object-[25%_center]"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-xs font-mono text-neutral-400">
                  NO IMAGE
                </div>
              )}
            </div>
            <p class="text-right text-xs font-mono font-bold tracking-widest uppercase text-black mt-1.5">
              “STYLE {panel.panelNumber || "01"}”
            </p>
          </div>
        );
      })}
    </div>

    <!-- Desktop Layout -->
    <div class="hidden md:flex flex-1 w-full h-full min-h-0 relative z-10 flex-row items-center justify-center px-2">
      {panels.map((panel, index) => {
        const fullImageUrl = getStrapiMediaUrl(panel.image?.url);
        const panelClasses = getPanelClasses(panel.panelNumber);
          // (panel.panelNumber && STYLE_PANEL_CONFIGS[panel.panelNumber])

        const panelClassName = panelClasses.className;
        const panelClipPath = panelClasses.clipPath;

        return (
          <StylePanel
            client:load
            title={panel.title}
            description={panel.description}
            className={panelClassName}
            clipPath={panelClipPath}
          >
            {fullImageUrl ? (
              <img
                src={fullImageUrl}
                alt={panel.image?.alternativeText || panel.title}
                class="absolute inset-0 w-full h-full object-cover object-[25%_center] scale-105 group-hover:scale-110 transition-transform duration-500"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center text-xs font-mono text-neutral-400 bg-neutral-50">
                NO IMAGE
              </div>
            )}
          </StylePanel>
        );
      })}
    </div>
  </div>
</section>
