---
import Welcome from "../components/Welcome.astro";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import About from "../components/sections/About.astro";
import Panels1 from "../components/sections/Panels-1.astro";
import Style from "../components/sections/Style.astro";
import Info from "../components/sections/Info.astro";
import Album from "../components/sections/Works.astro";
import Connect from "../components/sections/Connect.astro";
import Comment from "../components/sections/Comment.astro";
import { getSections, isSectionEnabled } from "../lib/strapi";

const sections = await getSections();
---

<Layout sections={sections}>
	<!-- <Welcome /> -->
	{isSectionEnabled(sections, "home", ["hero"]) && <Hero />}
	{isSectionEnabled(sections, "about") && <About />}
	{isSectionEnabled(sections, "info") && <Info />}
	{isSectionEnabled(sections, "style", ["styles"]) && <Style />}
	{isSectionEnabled(sections, "works", ["album", "work"]) && <Album />}
	{isSectionEnabled(sections, "connect", ["contact", "contacts"]) && <Connect />}
	{isSectionEnabled(sections, "comments", ["comment"]) && <Comment />}
	{isSectionEnabled(sections, "panels1", ["panels-1", "panel-1"]) && <Panels1 />}
</Layout>

